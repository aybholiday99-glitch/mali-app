{
  "name": "mali-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.3",
    "expo": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "pg": "8.16.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "node-forge": "file:vendor/node-forge-1.4.0.tgz",
    "micromatch": "file:vendor/mali-metro-glob-matcher-1.0.0.tgz"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/financialEngine.test.mjs tests/financialEngine.regression.test.mjs",
    "test:rls": "node --test tests/database.test.mjs",
    "test:sync": "node --test tests/supabaseSyncCore.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "build:web": "expo export --platform web",
    "test:security": "node --test tests/testEnvironment.test.mjs tests/sessionScope.test.mjs tests/database.test.mjs tests/exports.test.mjs tests/dependencyOverrides.test.mjs",
    "test:integration": "node --test tests/database.test.mjs tests/authIntegration.test.mjs tests/providerIntegration.test.mjs",
    "test:dependencies": "node --test tests/dependencyOverrides.test.mjs"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "node-forge": "$node-forge",
    "micromatch": "$micromatch"
  },
  "private": true
}
