{
  "expo": {
    "name": "مالي - Mali",
    "slug": "mali-app",
    "version": "1.0.0",
    "scheme": "mali",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.aybholiday.mali",
      "supportsTablet": true
    },
    "android": {
      "package": "com.aybholiday.mali",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "مالي - Mali",
      "shortName": "مالي",
      "lang": "ar",
      "themeColor": "#0F172A",
      "backgroundColor": "#0B1120",
      "display": "standalone"
    },
    "experiments": {
      "baseUrl": "/mali-app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم مالي الصورة التي تختارها لإرفاق إيصال بالعملية المالية.",
          "cameraPermission": "يستخدم مالي الكاميرا عند طلبك تصوير إيصال للعملية المالية.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "./plugins/withMaliFinancialStorage",
      "expo-router"
    ]
  }
}
